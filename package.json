{
  "name": "kotoba-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "description": "日语网页视频实时中文字幕桌面端",
  "author": "Kotoba Live",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "electron": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "package": "node scripts/package.js",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg dir --publish never",
    "billing:test": "node scripts/billing-test.js",
    "account:test": "node --env-file-if-exists=.env scripts/account-test.js",
    "account:email": "node --env-file-if-exists=.env scripts/account-test.js --email",
    "cloud:assets": "node scripts/cloud-assets.js",
    "cloud:dev": "npm run cloud:assets && wrangler dev --port 8795",
    "cloud:deploy": "npm run cloud:assets && wrangler deploy",
    "cloud:test": "wrangler deploy --dry-run --outdir output/cloud-bundle && node scripts/cloud-test.js"
  },
  "dependencies": {
    "better-auth": "1.7.3",
    "kysely": "0.29.5",
    "stripe": "^22.6.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^25.1.8",
    "miniflare": "5.20260903.0-alpha",
    "parse5": "8.0.0",
    "wrangler": "4.129.0"
  },
  "build": {
    "appId": "app.kotobalive.desktop",
    "productName": "Kotoba Live",
    "copyright": "Copyright © Kotoba Live",
    "directories": {
      "output": "dist/mac"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "extension/shared/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "用于采集播放窗口音频以生成实时字幕。",
        "NSMicrophoneUsageDescription": "用于采集播放窗口音频以生成实时字幕。",
        "NSAudioCaptureUsageDescription": "用于采集播放窗口音频以生成实时字幕。"
      }
    },
    "dmg": {
      "artifactName": "Kotoba-Live-${version}-mac-${arch}.${ext}"
    }
  }
}
