# 仅在本机文件中填写，切勿放入扩展或提交到版本控制。
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5
PORT=8787
# 可留空，每次服务启动时生成新的配对码。
RELAY_TOKEN=
# 每次会话最长分钟数；到时停止，需要用户重新开始。
MAX_SESSION_MINUTES=60

# 真实邮件验证码（npm run account:email），Stripe 支付仍使用测试模式。
# Resend 中已验证发信域名的 API Key；只填本机 .env，不放进网页或扩展。
RESEND_API_KEY=
# 只填邮箱地址，例如 login@auth.your-domain.com，不加显示名称。
KOTOBA_EMAIL_FROM=
ACCOUNT_EMAIL_PORT=8792

# Electron 桌面端（npm run electron / 打包后的 .app）读取以上 SONIOX_* 与 MAX_SESSION_MINUTES。
# 打包后请把本文件复制为 .env，放到以下任一位置：
# 1) 与「Kotoba Live.app」同一文件夹
# 2) ~/Library/Application Support/kotoba-live/.env
# macOS 首次采集窗口声音时，系统可能要求授予「屏幕录制」权限。
# 未签名包首次打开：右键 App → 打开；或到「系统设置 → 隐私与安全性」允许。
